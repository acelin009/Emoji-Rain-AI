# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Coverage
.coverage
htmlcov/
coverage.xml

# Environment variables
.env
.env.local

# MediaPipe / model download caches
models/*.task
models/*.tflite
!models/.gitkeep

# Large local media (keep repo lightweight; contributors add their own)
assets/fonts/*.ttf
assets/fonts/*.ttc
!assets/fonts/.gitkeep
docs/demo.gif
